# Copy this file to .env.local and fill in the values.
# All NEXT_PUBLIC_* values are inlined into the browser bundle at build time.

# Base URL of the product API (FakeStore API)
NEXT_PUBLIC_API_BASE_URL=https://fakestoreapi.com

# Public URL of the deployed site (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Key used to AES-GCM encrypt values stored in cookies (min 16 chars)
NEXT_PUBLIC_ENCRYPTION_KEY=change-me-to-a-long-random-string

# Secret used to sign the mock access/refresh tokens (min 16 chars)
NEXT_PUBLIC_TOKEN_SECRET=change-me-to-another-long-random-string
